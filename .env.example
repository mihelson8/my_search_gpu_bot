# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Separate token for the feline visual triage bot (vet_bot.py).
# Falls back to BOT_TOKEN when empty.
VET_BOT_TOKEN=

# MAX Messenger Bot (https://dev.max.ru/docs-api)
# Токен после модерации бота в кабинете MAX / «MAX для бизнеса»
MAX_BOT_TOKEN=
# auto | webhook | polling  (webhook нужен для production)
MAX_MODE=auto
# HTTPS URL вебхука на порту 443, например https://your-domain.com/max/webhook
MAX_WEBHOOK_URL=
# Секрет для заголовка X-Max-Bot-Api-Secret (5–256 символов: A-Z a-z 0-9 _ -)
MAX_WEBHOOK_SECRET=
# По умолчанию актуальный домен API
MAX_API_BASE=https://platform-api2.max.ru

# Health Check HTTP Port (for Render / Docker)
PORT=10000
