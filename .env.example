# Токен вашего Telegram бота от @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# API токен от сервиса Browserless.io (для удаленного браузера)
BROWSERLESS_TOKEN=your_browserless_api_token_here

# (Опционально) Публичный URL для вебхуков на Render/VPS.
# Если не указан, бот запустится в режиме Polling (подходит для локального запуска на ПК)
# WEBHOOK_URL=https://my-search-gpu-bot.onrender.com

# Порт для вебхука (Render передает его автоматически)
PORT=8000
