/* pages/index/index.wxss */
.container {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

/* Header Banner */
.header-banner {
  background: linear-gradient(135deg, #07c160, #10ad57);
  padding: 30rpx 24rpx;
  border-radius: 16rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
}

.banner-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.banner-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

/* Input Card */
.input-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

.input-textarea {
  width: 100%;
  height: 180rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #333333;
}

.input-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
}

.btn-clear {
  background: #f0f0f0;
  color: #666666;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  margin: 0;
}

.btn-translate {
  background: #07c160;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  padding: 10rpx 36rpx;
  border-radius: 30rpx;
  margin: 0;
}

/* Quick Tags */
.quick-tags-section {
  margin-bottom: 24rpx;
}

.tags-title {
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 12rpx;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-chip {
  background: #ffffff;
  border: 1rpx solid #e2e2e2;
  color: #555555;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
}

/* Voice Input Button */
.voice-section {
  margin-bottom: 28rpx;
}

.btn-voice {
  background: #ffffff;
  border: 2rpx solid #07c160;
  color: #07c160;
  font-size: 30rpx;
  font-weight: 500;
  padding: 24rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}

.btn-voice.recording {
  background: #ff4d4f;
  border-color: #ff4d4f;
  color: #ffffff;
  animation: pulse 1s infinite;
}

.voice-icon {
  margin-right: 12rpx;
  font-size: 34rpx;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.03); }
  100% { transform: scale(1); }
}

/* Result Card */
.result-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 30rpx;
}

.result-header {
  border-bottom: 2rpx solid #f0f0f0;
  padding-bottom: 16rpx;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #07c160;
}

.lang-row {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f7f7f7;
}

.lang-row:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.lang-label {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.flag {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.name {
  font-size: 26rpx;
  font-weight: bold;
  color: #666666;
}

.lang-content {
  background: #fbfbfb;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid #07c160;
}

.text {
  font-size: 30rpx;
  color: #222222;
  line-height: 1.4;
  word-break: break-word;
}

.zh-text {
  font-size: 34rpx;
  font-weight: 500;
  color: #07c160;
}

.pinyin-text {
  font-size: 26rpx;
  color: #888888;
  font-style: italic;
  margin-top: 6rpx;
}

.action-btns {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 12rpx;
}

.btn-audio, .btn-copy {
  background: #ffffff;
  border: 1rpx solid #d9d9d9;
  font-size: 24rpx;
  color: #555555;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  margin: 0;
}
